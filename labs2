using System;
using System.Collections.Generic;
using System.Globalization;

namespace AnimalZoo
{
    // ==========================================================
    // Базовый класс Animal
    // ==========================================================
    public abstract class Animal
    {
        public string Name { get; set; }        // Кличка
        public int Age { get; set; }             // Возраст
        public string Habitat { get; set; }       // Среда обитания
        public string FeedingType { get; set; }   // Тип питания
        public double Weight { get; set; }        // Вес (дополнительное поле)
        public string Color { get; set; }         // Окрас (дополнительное поле)

        protected Animal(string name, int age, string habitat, string feedingType, double weight, string color)
        {
            Name = name;
            Age = age;
            Habitat = habitat;
            FeedingType = feedingType;
            Weight = weight;
            Color = color;
        }

        // Базовая информация, которую наследники дополняют своими полями
        public virtual string GetInfo()
        {
            return $"Кличка: {Name}, Возраст: {Age}, Среда: {Habitat}, Питание: {FeedingType}, " +
                   $"Вес: {Weight} кг, Окрас: {Color}";
        }
    }

    // ==========================================================
    // Классы-наследники
    // ==========================================================
    public class Mammal : Animal
    {
        public bool HasFur { get; set; } // наличие шерсти

        public Mammal(string name, int age, string habitat, string feedingType,
                      double weight, string color, bool hasFur)
            : base(name, age, habitat, feedingType, weight, color)
        {
            HasFur = hasFur;
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $", Тип: Млекопитающее, Шерсть: {(HasFur ? "есть" : "нет")}";
        }
    }

    public class Bird : Animal
    {
        public double WingSpan { get; set; } // размах крыльев

        public Bird(string name, int age, string habitat, string feedingType,
                    double weight, string color, double wingSpan)
            : base(name, age, habitat, feedingType, weight, color)
        {
            WingSpan = wingSpan;
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $", Тип: Птица, Размах крыльев: {WingSpan} м";
        }
    }

    public class Fish : Animal
    {
        public string WaterType { get; set; } // пресная/морская

        public Fish(string name, int age, string habitat, string feedingType,
                    double weight, string color, string waterType)
            : base(name, age, habitat, feedingType, weight, color)
        {
            WaterType = waterType;
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $", Тип: Рыба, Вода: {WaterType}";
        }
    }

    public class Reptile : Animal
    {
        public bool IsVenomous { get; set; } // ядовитость

        public Reptile(string name, int age, string habitat, string feedingType,
                       double weight, string color, bool isVenomous)
            : base(name, age, habitat, feedingType, weight, color)
        {
            IsVenomous = isVenomous;
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $", Тип: Пресмыкающееся, Ядовитость: {(IsVenomous ? "да" : "нет")}";
        }
    }

    public class Amphibian : Animal
    {
        public string SkinMoisture { get; set; } // влажность кожи

        public Amphibian(string name, int age, string habitat, string feedingType,
                          double weight, string color, string skinMoisture)
            : base(name, age, habitat, feedingType, weight, color)
        {
            SkinMoisture = skinMoisture;
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $", Тип: Земноводное, Влажность кожи: {SkinMoisture}";
        }
    }

    // ==========================================================
    // Singleton: AnimalManager
    // ==========================================================
    public sealed class AnimalManager
    {
        private static AnimalManager _instance;
        private static readonly object _lock = new object();

        private readonly List<Animal> _animals;

        // Приватный конструктор не даёт создать экземпляр извне
        private AnimalManager()
        {
            _animals = new List<Animal>();
        }

        public static AnimalManager Instance
        {
            get
            {
                lock (_lock)
                {
                    if (_instance == null)
                    {
                        _instance = new AnimalManager();
                    }
                    return _instance;
                }
            }
        }

        public void AddAnimal(Animal animal)
        {
            if (animal == null) throw new ArgumentNullException(nameof(animal));
            _animals.Add(animal);
        }

        public int Count => _animals.Count;

        public void PrintAll()
        {
            if (_animals.Count == 0)
            {
                Console.WriteLine("Список животных пуст.");
                return;
            }

            for (int i = 0; i < _animals.Count; i++)
            {
                Console.WriteLine($"[{i}] {_animals[i].GetInfo()}");
            }
        }

        public void PrintByIndex(int index)
        {
            if (index < 0 || index >= _animals.Count)
            {
                Console.WriteLine("Животное с таким индексом не найдено.");
                return;
            }
            Console.WriteLine(_animals[index].GetInfo());
        }

        public void PrintByName(string name)
        {
            bool found = false;
            foreach (var animal in _animals)
            {
                if (string.Equals(animal.Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    Console.WriteLine(animal.GetInfo());
                    found = true;
                }
            }
            if (!found)
            {
                Console.WriteLine("Животное с таким именем не найдено.");
            }
        }
    }

    // ==========================================================
    // Точка входа и консольное меню
    // ==========================================================
    public static class dev2
    {
        public static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            AnimalManager manager = AnimalManager.Instance;

            // Демонстрация: создаём несколько объектов разных подтипов
            manager.AddAnimal(new Mammal("Барсик", 5, "лес", "хищник", 4.5, "рыжий", true));
            manager.AddAnimal(new Bird("Кеша", 2, "лес", "всеядное", 0.3, "зелёный", 0.25));
            manager.AddAnimal(new Fish("Немо", 1, "водоём", "всеядное", 0.05, "оранжевый", "морская"));
            manager.AddAnimal(new Reptile("Кузя", 3, "пустыня", "хищник", 1.2, "серый", false));
            manager.AddAnimal(new Amphibian("Квакин", 1, "водоём", "хищник", 0.02, "зелёный", "высокая"));

            RunMenu(manager);
        }

        private static void RunMenu(AnimalManager manager)
        {
            bool running = true;

            while (running)
            {
                Console.WriteLine();
                Console.WriteLine("===== Меню зоопарка =====");
                Console.WriteLine("1. Показать всех животных");
                Console.WriteLine("2. Показать животное по индексу");
                Console.WriteLine("3. Показать животное по имени");
                Console.WriteLine("4. Добавить новое животное");
                Console.WriteLine("5. Выход");
                Console.Write("Выберите пункт меню: ");

                string choice = Console.ReadLine();

                switch (choice)
                {
                    case "1":
                        manager.PrintAll();
                        break;

                    case "2":
                        Console.Write("Введите индекс: ");
                        if (int.TryParse(Console.ReadLine(), out int index))
                        {
                            manager.PrintByIndex(index);
                        }
                        else
                        {
                            Console.WriteLine("Некорректный ввод индекса.");
                        }
                        break;

                    case "3":
                        Console.Write("Введите имя: ");
                        string name = Console.ReadLine();
                        manager.PrintByName(name);
                        break;

                    case "4":
                        AddAnimalViaMenu(manager);
                        break;

                    case "5":
                        running = false;
                        Console.WriteLine("Выход из программы...");
                        break;

                    default:
                        Console.WriteLine("Некорректный пункт меню. Попробуйте снова.");
                        break;
                }
            }
        }

        private static void AddAnimalViaMenu(AnimalManager manager)
        {
            Console.WriteLine();
            Console.WriteLine("Выберите тип животного:");
            Console.WriteLine("1. Млекопитающее");
            Console.WriteLine("2. Птица");
            Console.WriteLine("3. Рыба");
            Console.WriteLine("4. Пресмыкающееся");
            Console.WriteLine("5. Земноводное");
            Console.Write("Ваш выбор: ");
            string typeChoice = Console.ReadLine();

            // Общие поля
            string name = ReadString("Кличка: ");
            int age = ReadInt("Возраст: ");
            string habitat = ReadString("Среда обитания: ");
            string feedingType = ReadString("Тип питания: ");
            double weight = ReadDouble("Вес (кг): ");
            string color = ReadString("Окрас: ");

            switch (typeChoice)
            {
                case "1":
                    bool hasFur = ReadBool("Есть шерсть? (да/нет): ");
                    manager.AddAnimal(new Mammal(name, age, habitat, feedingType, weight, color, hasFur));
                    Console.WriteLine("Млекопитающее успешно добавлено.");
                    break;

                case "2":
                    double wingSpan = ReadDouble("Размах крыльев (м): ");
                    manager.AddAnimal(new Bird(name, age, habitat, feedingType, weight, color, wingSpan));
                    Console.WriteLine("Птица успешно добавлена.");
                    break;

                case "3":
                    string waterType = ReadString("Тип воды (пресная/морская): ");
                    manager.AddAnimal(new Fish(name, age, habitat, feedingType, weight, color, waterType));
                    Console.WriteLine("Рыба успешно добавлена.");
                    break;

                case "4":
                    bool isVenomous = ReadBool("Ядовитое? (да/нет): ");
                    manager.AddAnimal(new Reptile(name, age, habitat, feedingType, weight, color, isVenomous));
                    Console.WriteLine("Пресмыкающееся успешно добавлено.");
                    break;

                case "5":
                    string skinMoisture = ReadString("Влажность кожи (низкая/средняя/высокая): ");
                    manager.AddAnimal(new Amphibian(name, age, habitat, feedingType, weight, color, skinMoisture));
                    Console.WriteLine("Земноводное успешно добавлено.");
                    break;

                default:
                    Console.WriteLine("Некорректный тип животного. Добавление отменено.");
                    break;
            }
        }

        // ---------- Вспомогательные методы для безопасного ввода ----------

        private static string ReadString(string prompt)
        {
            Console.Write(prompt);
            string input = Console.ReadLine();
            while (string.IsNullOrWhiteSpace(input))
            {
                Console.Write("Значение не может быть пустым. Повторите ввод: ");
                input = Console.ReadLine();
            }
            return input;
        }

        private static int ReadInt(string prompt)
        {
            Console.Write(prompt);
            while (true)
            {
                if (int.TryParse(Console.ReadLine(), out int result))
                {
                    return result;
                }
                Console.Write("Некорректное число. Повторите ввод: ");
            }
        }

        private static double ReadDouble(string prompt)
        {
            Console.Write(prompt);
            while (true)
            {
                string input = Console.ReadLine();
                if (double.TryParse(input, NumberStyles.Any, CultureInfo.InvariantCulture, out double result) ||
                    double.TryParse(input, out result))
                {
                    return result;
                }
                Console.Write("Некорректное число. Повторите ввод: ");
            }
        }

        private static bool ReadBool(string prompt)
        {
            Console.Write(prompt);
            while (true)
            {
                string input = Console.ReadLine()?.Trim().ToLowerInvariant();
                if (input == "да" || input == "yes" || input == "y")
                {
                    return true;
                }
                if (input == "нет" || input == "no" || input == "n")
                {
                    return false;
                }
                Console.Write("Введите 'да' или 'нет': ");
            }
        }
    }
}
